# --- Client-side (public) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key-from-supabase
NEXT_PUBLIC_API_BASE_URL=http://localhost:5173

# --- Server-only secrets (recommended: set these in your shell for local dev
#     or add them to your local .env.local but ensure .env.local is in .gitignore) ---
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # DO NOT prefix with NEXT_PUBLIC_
# GITHUB_TOKEN=ghp_...                                      # Personal access token or app token

# --- Optional (only if you need SMTP locally) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-pass
